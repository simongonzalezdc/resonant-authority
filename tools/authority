#!/bin/sh
# authority - contextual authority (routing weights, never voting)
# Self-contained copy for the resonant-authority add-on.
# Score = weighted ACCEPTED-count per lane; rejected reported separately, never subtracted.
# Ties: score desc, matched-event count desc, lane name asc (byte order).
# Sources: relative paths resolve against this tool's ROOT, not the caller's cwd.
# Security: NO shell execution on ledger content (source existence pre-checked via
# plain [ -f ] in shell, membership passed to awk as a file); record refuses any
# field containing quotes, backslashes, $, backticks, or non-printable characters.
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
LEDGER="$ROOT/authority-ledger/events.jsonl"
DIMS="$ROOT/authority-ledger/dimensions.txt"
HUMANS="$ROOT/authority-ledger/human-lanes.txt"
mkdir -p "$ROOT/authority-ledger"
[ -f "$DIMS" ] || printf 'memory\nplanning\nshell\nprocess\n' > "$DIMS"
[ -f "$HUMANS" ] || printf 'simon\n' > "$HUMANS"
[ -f "$LEDGER" ] || : > "$LEDGER"

usage() { echo "usage: authority record --date Y-M-D --dimension D --lane L --verdict accepted|rejected --source PATH [--human] [--note t] | authority question --dimensions D1,D2 [--weights \"D1=0.7,D2=0.3\"]"; exit 2; }

[ $# -lt 1 ] && usage
CMD="$1"; shift

case "$CMD" in
  record)
    DATE=""; DIM=""; LANE=""; VERDICT=""; SOURCE=""; HUMAN=0; NOTE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --date) [ $# -ge 2 ] || usage; DATE="$2"; shift 2 ;;
        --dimension) [ $# -ge 2 ] || usage; DIM="$2"; shift 2 ;;
        --lane) [ $# -ge 2 ] || usage; LANE="$2"; shift 2 ;;
        --verdict) [ $# -ge 2 ] || usage; VERDICT="$2"; shift 2 ;;
        --source) [ $# -ge 2 ] || usage; SOURCE="$2"; shift 2 ;;
        --note) [ $# -ge 2 ] || usage; NOTE="$2"; shift 2 ;;
        --human) HUMAN=1; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$DATE" ] && [ -n "$DIM" ] && [ -n "$LANE" ] && [ -n "$VERDICT" ] && [ -n "$SOURCE" ] \
      || { echo "authority: REFUSED — all of --date --dimension --lane --verdict --source required" >&2; exit 1; }
    [ "$VERDICT" = "accepted" ] || [ "$VERDICT" = "rejected" ] \
      || { echo "authority: REFUSED — verdict must be accepted|rejected (map: APPROVE/PASS->accepted; ITERATE/FAIL/REQUEST-CHANGES->rejected)" >&2; exit 1; }
    grep -Fqx "$DIM" "$DIMS" || { echo "authority: REFUSED — unknown dimension '$DIM' (registry: $DIMS)" >&2; exit 1; }
    if grep -Fqx "$LANE" "$HUMANS"; then
      [ "$HUMAN" = "1" ] || { echo "authority: REFUSED — lane '$LANE' is human-class: --human required" >&2; exit 1; }
    else
      [ "$HUMAN" = "0" ] || { echo "authority: REFUSED — lane '$LANE' is not in human-lanes: --human forbidden" >&2; exit 1; }
    fi
    for v in "$DATE" "$DIM" "$LANE" "$VERDICT" "$SOURCE" "$NOTE"; do
      printf '%s' "$v" | grep -q '["$`\]' && { echo "authority: REFUSED — fields may not contain double quotes, backslashes, dollar signs, or backticks" >&2; exit 1; }
      printf '%s' "$v" | LC_ALL=C grep -q '[^ -~]' && { echo "authority: REFUSED — fields must be single-line printable ASCII" >&2; exit 1; }
    done
    CLASS=agent; [ "$HUMAN" = "1" ] && CLASS=human
    printf '{"date":"%s","dimension":"%s","lane":"%s","verdict":"%s","source":"%s","class":"%s","note":"%s"}\n' \
      "$DATE" "$DIM" "$LANE" "$VERDICT" "$SOURCE" "$CLASS" "$NOTE" >> "$LEDGER"
    echo "RECORDED: $DATE $DIM $LANE $VERDICT ($CLASS)"
    ;;
  question)
    DECL=""; WSTR=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dimensions) [ $# -ge 2 ] || usage; DECL="$2"; shift 2 ;;
        --weights) [ $# -ge 2 ] || usage; WSTR="$2"; shift 2 ;;
        *) usage ;;
      esac
    done
    [ -n "$DECL" ] || usage
    # empty-field guard (leading/trailing/double commas) — word splitting drops empties
    printf '%s' "$DECL" | grep -qE '^,|,,|,$' \
      && { echo "authority: REFUSED — empty dimension in '$DECL'" >&2; exit 1; }
    # dimension validation: known, non-empty, no duplicates
    BADDIM=""; DUPDIM=0
    for d in $(printf '%s' "$DECL" | tr ',' ' '); do
      [ -n "$d" ] || BADDIM="$BADDIM (empty)"
      grep -Fqx "$d" "$DIMS" || BADDIM="$BADDIM $d"
      C=$(printf '%s' "$DECL" | tr ',' '\n' | grep -Fcx "$d")
      [ "$C" -gt 1 ] && DUPDIM=1
    done
    [ -z "$BADDIM" ] && [ "$DUPDIM" = "0" ] \
      || { echo "authority: REFUSED — unknown, empty, or duplicate dimension(s) in '$DECL' (registry: $DIMS)" >&2; exit 1; }
    echo "DECLARED DIMENSIONS: $DECL"
    ND=$(printf '%s\n' "$DECL" | awk -F, '{print NF}')
    if [ -n "$WSTR" ]; then
      echo "DECLARED WEIGHTS: $WSTR"
      printf '%s' "$WSTR" | awk -F, -v decl="$DECL" '
        BEGIN { n = split(decl, d, ","); for (i=1;i<=n;i++) dd[d[i]]=1 }
        {
          m = split($0, p, ","); sum = 0; bad = 0
          for (i=1;i<=m;i++) {
            split(p[i], kv, "=")
            if (!(kv[1] in dd)) bad = 1
            if (kv[2] + 0 <= 0) bad = 1
            if (++seen[kv[1]] != 1) bad = 1
            sum += kv[2] + 0
          }
          if (m != n) bad = 1
          for (k in dd) if (!(k in seen)) bad = 1
          if (sum < 0.999 || sum > 1.001) bad = 1
          exit bad
        }' || { echo "authority: REFUSED — malformed weights (must cover the declared dimensions exactly once, be positive, and sum to 1.0)" >&2; exit 1; }
      WSPEC="$WSTR"
    else
      EQ=$(awk -v n="$ND" 'BEGIN{printf "%.4f", 1/n}')
      echo "WEIGHTS: equal ($EQ each)"
      WSPEC="equal"
    fi
    # source existence pre-pass: plain shell [ -f ] only — ledger content NEVER
    # reaches a shell command (kills injection by construction, including hand-edits)
    OKL=$(mktemp); trap 'rm -f "$OKL"' EXIT
    sed -n 's/.*"source":"\([^"]*\)".*/\1/p' "$LEDGER" | sort -u | while IFS= read -r s; do
      case "$s" in /*) ;; *) s="$ROOT/${s#./}" ;; esac
      [ -f "$s" ] && printf '%s\n' "$s"
    done > "$OKL"
    # pass 1: agent lanes ranking (+ dual-class + unverified reporting)
    export AUTH_ROOT="$ROOT"
    RANKED=$(awk -v decl="$DECL" -v w="$WSPEC" '
      NR == FNR { ok[$0] = 1; next }
      BEGIN {
        root = ENVIRON["AUTH_ROOT"]
        n = split(decl, d, ",")
        for (i=1;i<=n;i++) dimset[d[i]] = 1
        if (w == "equal") { for (i=1;i<=n;i++) wt[d[i]] = 1/n }
        else { m = split(w, p, ","); for (i=1;i<=m;i++){ split(p[i], kv, "="); wt[kv[1]] = kv[2]+0 } }
      }
      {
        line = $0
        dim = line; sub(/.*"dimension":"/, "", dim); sub(/".*/, "", dim)
        lane = line; sub(/.*"lane":"/, "", lane); sub(/".*/, "", lane)
        ver = line; sub(/.*"verdict":"/, "", ver); sub(/".*/, "", ver)
        src = line; sub(/.*"source":"/, "", src); sub(/".*/, "", src)
        cls = line; sub(/.*"class":"/, "", cls); sub(/".*/, "", cls)
        if (!(dim in dimset)) next
        if (src !~ /^\//) { sub(/^\.\//, "", src); src = root "/" src }
        if (!(src in ok)) { print "unverified, excluded: " lane " " dim " " src > "/dev/stderr"; next }
        if (cls == "human") { hum[lane] = 1; hseen[lane] = 1; next }
        key = lane SUBSEP dim
        if (ver == "accepted") acc[key]++
        else if (ver == "rejected") rej[key]++
        matched[lane]++
        agent[lane] = 1
        if (lane in hum) shelved[lane]++
      }
      END {
        for (k in acc) { split(k, a, SUBSEP); lanes[a[1]] = 1 }
        for (k in rej) { split(k, a, SUBSEP); lanes[a[1]] = 1 }
        for (l in hum) lanes[l] = 1
        for (l in lanes) if ((l in agent) && (l in hum)) print "dual-class lane, agent events shelved: " l " (" shelved[l]+0 " events)" > "/dev/stderr"
        for (l in lanes) {
          if (!(l in agent) || (l in hum)) continue
          sc = 0; na = 0; nr = 0
          for (i=1;i<=n;i++) {
            sc += wt[d[i]] * (acc[l SUBSEP d[i]] + 0)
            na += (acc[l SUBSEP d[i]] + 0); nr += (rej[l SUBSEP d[i]] + 0)
          }
          printf "%.4f %d %s %d %d\n", sc, matched[l], l, na, nr
        }
      }' "$OKL" "$LEDGER")
    # human section (own class, never blended)
    HUMANOUT=$(awk -v decl="$DECL" '
      NR == FNR { ok[$0] = 1; next }
      BEGIN { root = ENVIRON["AUTH_ROOT"]; n = split(decl, d, ","); for (i=1;i<=n;i++) dimset[d[i]] = 1 }
      {
        line = $0
        dim = line; sub(/.*"dimension":"/, "", dim); sub(/".*/, "", dim)
        lane = line; sub(/.*"lane":"/, "", lane); sub(/".*/, "", lane)
        ver = line; sub(/.*"verdict":"/, "", ver); sub(/".*/, "", ver)
        src = line; sub(/.*"source":"/, "", src); sub(/".*/, "", src)
        cls = line; sub(/.*"class":"/, "", cls); sub(/".*/, "", cls)
        if (!(dim in dimset) || cls != "human") next
        if (src !~ /^\//) { sub(/^\.\//, "", src); src = root "/" src }
        if (!(src in ok)) next
        if (ver == "accepted") acc[lane]++; else rej[lane]++
        seen[lane] = 1
      }
      END { for (l in seen) printf "%s %d %d\n", l, acc[l]+0, rej[l]+0 }' "$OKL" "$LEDGER")
    if [ -z "$RANKED" ] && [ -z "$HUMANOUT" ]; then
      echo "no verified outcomes in these dimensions"
      exit 0
    fi
    if [ -n "$RANKED" ]; then
      echo "AGENT LANES (weighted accepted-count; rejections separate):"
      printf '%s\n' "$RANKED" | LC_ALL=C sort -k1,1rn -k2,2rn -k3,3 | awk '
        { printf "  %d. %-22s score %-8s accepted %s rejected %s\n", NR, $3, $1, $4, $5 }'
    fi
    if [ -n "$HUMANOUT" ]; then
      echo "HUMAN (separate class, never blended):"
      printf '%s\n' "$HUMANOUT" | while read -r hl ha hr; do
        echo "  $hl: accepted $ha, rejected $hr"
      done
    fi
    ;;
  *) usage ;;
esac
